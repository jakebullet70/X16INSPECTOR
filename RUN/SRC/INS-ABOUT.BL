## ------------------------------------------------------
## BASLOAD ISO CRLF 
##
## INS-ABOUT.BL, ABOUT SCREEN 
## 
## (C)SADLOGIC 2024-26
##
## ------------------------------------------------------
#SYMFILE "@:INS-ABOUT.SYM"
#SAVEAS "@:INS-ABOUT.PRG"
#CONTROLCODES 1


REM --- ABOUT / CREDITS SCREEN ---


CLS : SCREEN 3 : COLOR 1,0

GOSUB OPTIONS.INIT.VARS
GOSUB OPTIONS.LOAD

REM --- colours follow the saved theme (OPTIONS.THEME: 1=dark 2=light) ---
IF OPTIONS.THEME <> 2 THEN DEFAULT.FG.COLOR=1 : DEFAULT.BG.COLOR=0  : HEADER.FG.COLOR=15 : HEADER.BG.COLOR=0  : TITLE.FG.COLOR=4
IF OPTIONS.THEME =  2 THEN DEFAULT.FG.COLOR=0 : DEFAULT.BG.COLOR=1 : HEADER.FG.COLOR=11 : HEADER.BG.COLOR=1 : TITLE.FG.COLOR=4


GOSUB START
SPRITE 1,0
LOAD "INSPECTOR.PRG"
END


START: 

 COLOR TITLE.FG.COLOR, HEADER.BG.COLOR
 CLS 

 POKE 903,60  : REM --- CHANGES THE ROW SIZE SO THE LAST CHAR DOES NOT SCROOL THE SCREEN
 REM LOCATE 30,1  : PRINT "RETURN SELECTS    ARROW KEYS TO NAVIGATE";
 LOCATE 30,1  : PRINT "             RETURN TO EXIT";
 POKE 903,30  : REM --- PUT IT BACK TO THE ORIGINAL

 LOCATE 2,8 : PRINT "** INSPECTOR  CLUE-LESS **"

 COLOR DEFAULT.FG.COLOR
 REM -- 1234567890123456789012345678901234567890
 LOCATE 5,2  : PRINT "A MURDER-MYSTERY WHODUNIT FOR"
 LOCATE 6,2  : PRINT "THE COMMANDER X16."

 COLOR TITLE.FG.COLOR
 PCROW=9  : PC$="-- WHERE IT CAME FROM --"         : GOSUB PRINT.CENTERED

 COLOR DEFAULT.FG.COLOR
 PCROW=11 : PC$="1979  A TYPE-IN BASIC GAME IN"    : GOSUB PRINT.CENTERED
 PCROW=12 : PC$="CREATIVE COMPUTING (JUNE,"        : GOSUB PRINT.CENTERED
 PCROW=13 : PC$="VOL 5 #6): 'INSPECTOR"            : GOSUB PRINT.CENTERED
 PCROW=14 : PC$="CLEW-SO' BY RON CARLSON."         : GOSUB PRINT.CENTERED
 PCROW=16 : PC$="1987  COMMODORE 16 'INSPEKTOR'"   : GOSUB PRINT.CENTERED
 PCROW=17 : PC$="BY ANDREAS ZILLA."                : GOSUB PRINT.CENTERED
 PCROW=19 : PC$="2024  C64 REMAKE BY KWAYNE."      : GOSUB PRINT.CENTERED

 COLOR TITLE.FG.COLOR
 PCROW=22 : PC$="-- THIS VERSION --"               : GOSUB PRINT.CENTERED

 COLOR DEFAULT.FG.COLOR
 PCROW=24 : PC$="DRAWS ON ALL THREE, BUT THE CODE" : GOSUB PRINT.CENTERED
 PCROW=25 : PC$="IS ALL NEW. WRITTEN 2024-26, BY:" : GOSUB PRINT.CENTERED
 PCROW=27 : PC$="SADLOGIC - STEVEN DE GEORGE SR"   : GOSUB PRINT.CENTERED
 

 GOSUB ABOUT.SHOW.SLEUTH

WAITKEY01MNU:
 GET A$ : IF A$="" THEN GOTO WAITKEY01MNU
 RETURN


PRINT.CENTERED:
 PCCOL = INT((40 - LEN(PC$)) / 2) + 1
 LOCATE PCROW, PCCOL : PRINT PC$
 RETURN


ABOUT.SHOW.SLEUTH:
 ## --- load the single 64x64 detective sprite (2048 bytes) and show it. Uses
 ## --- palette offset 1 (VERA entries 16-31). Entry N at $1:FA00+N*2;
 ## --- byte0=(G<<4)|B, byte1=R.  1=blk 2=coat 3=skin 4=wht 5=blu 6=shadow.
 BVLOAD "/SPRITES/DETECTIVE.SPR",8,1,$3000
 VPOKE 1,$FA22,$00 : VPOKE 1,$FA23,$00 : REM --- 17 black  $000
 VPOKE 1,$FA24,$91 : VPOKE 1,$FA25,$0F : REM --- 18 coat   $F91
 VPOKE 1,$FA26,$98 : VPOKE 1,$FA27,$0F : REM --- 19 skin   $F98
 VPOKE 1,$FA28,$FF : VPOKE 1,$FA29,$0F : REM --- 20 white  $FFF
 VPOKE 1,$FA2A,$6E : VPOKE 1,$FA2B,$02 : REM --- 21 blue   $26E
 VPOKE 1,$FA2C,$60 : VPOKE 1,$FA2D,$0C : REM --- 22 shadow $C60
 SPRMEM 1,1,$3000,0
 SPRITE 1,3,1,0,3,3
 ## --- top-right accent (SCREEN 3, so px = (col-1)*8): cols 33-40, rows 1-8.
 MOVSPR 1,256,0
 RETURN


#INCLUDE "/SRC/OPTIONS-SL.BL"
