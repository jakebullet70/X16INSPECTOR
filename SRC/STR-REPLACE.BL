## VARS:
## -' 
## -' STRS$(9), GENERIC STRING ARRAY
## -' 
## -' 
## -' 100 STRS$(STR.TARGET)="HELLO WORLD":STRS$(STR.FIND)="WORLD":STRS$(STR.REPLACE)="C64"
## -' 110 P=1
## -' 120 IF P>LEN(STRS$(STR.TARGET))-LEN(STRS$(STR.FIND))+1 THEN 180
## -' 130 IF MID$(STRS$(STR.TARGET),P,LEN(STRS$(STR.FIND)))<>STRS$(STR.FIND) THEN 170
## -' 140 STRS$(STR.TMPL)=LEFT$(STRS$(STR.TARGET),P-1)
## -' 150 STRS$(STR.TMPR)=RIGHT$(STRS$(STR.TARGET),LEN(STRS$(STR.TARGET))-P-LEN(STRS$(STR.FIND))+1)
## -' 160 STRS$(STR.TARGET)=STRS$(STR.TMPL)+STRS$(STR.REPLACE)+STRS$(STR.TMPR):GOTO 180
## -' 170 P=P+1:GOTO 120
## -' 180 PRINT STRS$(STR.TARGET)

#DEFINE STR.FIND 1
#DEFINE STR.TARGET 0
#DEFINE STR.REPLACE 2
#DEFINE STR.RETURN.VAL 0
#DEFINE STR.TMPR 6
#DEFINE STR.TMPL 5
#DEFINE STR.TMP 7


## '--- NEED TO WRITE A TEST CASE, WAS WORKING...
## '--- NEED TO WRITE A TEST CASE, WAS WORKING...
## '--- NEED TO WRITE A TEST CASE, WAS WORKING...
