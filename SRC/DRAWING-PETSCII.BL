## ------------------------------------------------------
## BASLOAD ISO CRLF
##
##
##
##
##
## ------------------------------------------------------



## --- Themes set two layers of colour: the CLR.* strings ("NN{TOKEN}", where NN is
## --- the VAL()-able colour number and {TOKEN} is the matching control code) used by
## --- the game screens, and the numeric menu colours used by the title-screen menu
## --- (INTRO.BL).  Applied once at startup in INSPECTOR.BL before anything is drawn.

SET.THEME.DARK:
	## --- dark: light text on a black background (the original look) ---
	CLR.BACKGROUND$        = "00{BLACK}"
	CLR.FGTEXT.NORMAL$     = "01{WHITE}"
	CLR.FGTEXT.BRIGHT$     = "05{GRN}"
	CLR.FGTEXT.ALERT$      = "02{RED}"
	CLR.FGTEXT.BACKGROUND$ = CLR.BACKGROUND$

	CLR.MNU.FG.BAR$    = CLR.FGTEXT.BRIGHT$
	CLR.MNU.BG.BAR$    = CLR.BACKGROUND$
	CLR.MNU.FG.HL.BAR$ = CLR.FGTEXT.NORMAL$
	CLR.MNU.BG.HL.BAR$ = CLR.FGTEXT.BRIGHT$
	CLR.BG.MUGSHOT$    = "11{GREY 3}"

	## --- title-screen menu (INTRO.BL) ---
	DEFAULT.FG.COLOR=1  : DEFAULT.BG.COLOR=0
	SELECTED.FG.COLOR=1 : SELECTED.BG.COLOR=0
	ACTIVE.FG.COLOR=1   : ACTIVE.BG.COLOR=6
	HEADER.FG.COLOR=15  : HEADER.BG.COLOR=0
	TITLE.FG.COLOR=4
	RETURN

SET.THEME.LIGHT:
	## --- light: dark text on a light-grey background ---
	CLR.BACKGROUND$        = "15{GREY 1}"
	CLR.FGTEXT.NORMAL$     = "00{BLACK}"
	CLR.FGTEXT.BRIGHT$     = "06{BLUE}"
	CLR.FGTEXT.ALERT$      = "02{RED}"
	CLR.FGTEXT.BACKGROUND$ = CLR.BACKGROUND$

	CLR.MNU.FG.BAR$    = "06{BLUE}"
	CLR.MNU.BG.BAR$    = CLR.BACKGROUND$
	CLR.MNU.FG.HL.BAR$ = "01{WHITE}"
	CLR.MNU.BG.HL.BAR$ = "06{BLUE}"
	CLR.BG.MUGSHOT$    = "12{GREY 2}"

	## --- title-screen menu (INTRO.BL) ---
	DEFAULT.FG.COLOR=0  : DEFAULT.BG.COLOR=15
	SELECTED.FG.COLOR=0 : SELECTED.BG.COLOR=15
	ACTIVE.FG.COLOR=1   : ACTIVE.BG.COLOR=6
	HEADER.FG.COLOR=11  : HEADER.BG.COLOR=15
	TITLE.FG.COLOR=4
	RETURN



DRAW.DIAGRAM:
	## --- Original C64 "INSPEKTOR" house layout, relabelled to this game's rooms. ---
	## --- Offset colour-coded rooms with a tree and shrubs on the lawn.  The rooms ---
	## --- are decorative; their names match ROOMS$(): OFFICE BASEMENT KITCHEN     ---
	## --- CLOSET LIBRARY GARAGE.  Ported byte-for-byte from the C64 original.      ---
	## --- The graphic shrub/tree glyphs live outside ASCII, so build them w/ CHR$. ---
	GL.SHRUB$  = CHR$(204) : REM --- shrub / hedge dot
	GL.TREE$   = CHR$(165) : REM --- tree-trunk block
	GL.HEDGE$  = CHR$(199) : REM --- hedge run
	GL.BRANCH$ = CHR$(175) : REM --- branch block
	## --- pin the background to black while drawing so the reverse-video room labels ---
	## --- read as black on any theme (the house is a fixed picture, not theme-tinted) ---
	COLOR 1,0
	## --- widen the logical line so a full 40-column PRINT won't scroll the screen ---
	POKE 903,60
	LOCATE 1,1 : PRINT "{RVS ON}{GREEN}             {GREY 1}                       {GREEN}    " ;
	LOCATE 2,1 : PRINT "{RVS ON}{GREEN}       {RVS OFF}                        {RVS ON}  {GREY 1}   {GREEN}    " ;
	LOCATE 3,1 : PRINT "{RVS ON}{GREEN}       {RVS OFF} {RVS ON} {CYAN}" + GL.SHRUB$ + GL.SHRUB$ + "{GREEN}  {BROWN}" + GL.TREE$ + "{GREEN}  {CYAN}" + GL.SHRUB$ + GL.SHRUB$ ;
	PRINT "{GREEN} {RVS OFF}   {RVS ON}{GREY 3}        {RVS OFF} {RVS ON}{GREEN}  {GREY 1}   {GREEN}    " ;
	LOCATE 4,1 : PRINT "{RVS ON}{GREEN}       {RVS OFF} {RVS ON}     {BROWN}" + GL.SHRUB$ + "{GREEN}     {RVS OFF}   {RVS ON}{GREY 3}        {RVS OFF} {RVS ON}{GREEN}  {GREY 1}   {GREEN}    " ;
	LOCATE 5,1 : PRINT "{RVS ON}{GREEN} {RVS OFF}       {RVS ON}{LIGHT GREEN}  OFFICE   {RVS OFF}   {RVS ON}{GREY 2}BASEMENT{RVS OFF}         {RVS ON}{GREEN} " ;
	LOCATE 6,1 : PRINT "{RVS ON}{GREEN} {RVS OFF} {RVS ON}{BLUE} {CYAN}" + GL.SHRUB$ + "{BLUE}   {RVS OFF} {RVS ON}{LIGHT GREEN}           {GREY 3}" + GL.HEDGE$ + GL.HEDGE$ + GL.HEDGE$ ;
	PRINT "{GREY 2}        {RVS OFF} {RVS ON}  {GREY 3}" + GL.TREE$ + "  {GREY 2}" + GL.TREE$ + " {RVS OFF} {RVS ON}{GREEN} " ;
	LOCATE 7,1 : PRINT "{RVS ON}{GREEN} {RVS OFF} {RVS ON}{BLUE}     {RVS OFF}  {RVS ON}{LIGHT GREEN} {RVS OFF}                     {RVS ON}{GREY 2}  {GREY 3}" + GL.SHRUB$ + GL.BRANCH$ + GL.BRANCH$ + "{GREY 2}" + GL.TREE$ ;
	PRINT " {RVS OFF} {RVS ON}{GREEN} " ;
	LOCATE 8,1 : PRINT "{RVS ON}{GREEN} {RVS OFF} {RVS ON}{LIGHT BLUE}     {BLUE}  {LIGHT GREEN} {BLUE} {RVS OFF} {RVS ON}{RED}       {RVS OFF} {RVS ON}{BROWN}         {RVS OFF} {RVS ON}{GREY 2} {GREY 1}       {RVS OFF} {RVS ON}{GREEN} " ;
	LOCATE 9,1 : PRINT "{RVS ON}{GREEN} {RVS OFF} {RVS ON}{LIGHT BLUE}     {BLUE}  {LIGHT BLUE} {BLUE} {RVS OFF} {RVS ON}{RED}       {RVS OFF} {RVS ON}{BROWN}         {RVS OFF} {RVS ON}{GREY 2} {GREY 1}       {RVS OFF} {RVS ON}{GREEN} " ;
	LOCATE 10,1 : PRINT "{RVS ON}{GREEN} {RVS OFF} {RVS ON}{LIGHT BLUE} KITCHEN {BLUE} {LIGHT RED} CLOSET{BROWN} {ORANGE} LIBRARY {GREY 2} {GREY 1} GARAGE {RVS OFF} {RVS ON}{GREEN} " ;
	LOCATE 11,1 : PRINT "{RVS ON}{GREEN} {RVS OFF} {RVS ON}{LIGHT BLUE}         {RVS OFF} {RVS ON}{LIGHT RED}       {RVS OFF} {RVS ON}{ORANGE}         {RVS OFF} {RVS ON}{GREY 1}        {RVS OFF} {RVS ON}{GREEN} " ;
	LOCATE 12,1 : PRINT "{RVS ON}{GREEN} {RVS OFF}                                      {RVS ON} " ;
	LOCATE 13,1 : PRINT "{RVS ON}{GREEN} {YELLOW}  {CYAN}" + GL.SHRUB$ + "{YELLOW}         {CYAN}" + GL.SHRUB$ + "{YELLOW}   {CYAN}" + GL.SHRUB$ + "{YELLOW}   {CYAN}" + GL.SHRUB$ + GL.SHRUB$ + "{YELLOW}   {CYAN}" + GL.SHRUB$ ;
	PRINT GL.SHRUB$ + "{YELLOW}           {GREEN} " ;
	LOCATE 14,1 : PRINT "{RVS ON}{GREEN} {YELLOW}                                      {GREEN} " ;
	POKE 903,30
	PRINT "{RVS OFF}";
	COLOR VAL(CLR.FGTEXT.NORMAL$),VAL(CLR.BACKGROUND$)
	RETURN





CLEAR.PROMPT.SCREEN:
	GOSUB TURN.OFF.ALL.SPRITES
	COLOR VAL(CLR.FGTEXT.BACKGROUND$),VAL(CLR.BACKGROUND$)
	PRINT "{RVS ON}";
	POKE 903,60	 : REM --- CHANGES THE ROW SIZE SO THE LAST CHAR DOES NOT SCROLL THE SCREEN
	FOR NDX = 15 TO 30
		LOCATE NDX,1 : PRINT RPT$(ASC(" "),40);
	NEXT
	POKE 903,30  : REM --- PUT IT BACK TO THE ORIGINAL
	PRINT "{RVS OFF}"; : COLOR VAL(CLR.FGTEXT.NORMAL$),VAL(CLR.BACKGROUND$)
	RETURN


CLEAR.MUGSHOT:
	COLOR VAL(CLR.BG.MUGSHOT$), VAL(CLR.BG.MUGSHOT$)
	PRINT "{RVS ON}";
	FOR NDX = 20 TO 25
		LOCATE NDX,34 : PRINT RPT$(ASC(" "),6);
	NEXT
	PRINT "{RVS OFF}"; : COLOR VAL(CLR.FGTEXT.NORMAL$),VAL(CLR.BACKGROUND$)
	RETURN


SHOW.MUGSHOT:
	GOSUB CLEAR.MUGSHOT : GOSUB SHOW.SPRITE
	RETURN


SETUP.PROMPT.SCREEN:
	GOSUB CLEAR.PROMPT.SCREEN
	IF ShowTheMugshotFlag > 0 THEN GOSUB SHOW.MUGSHOT
	GOSUB KB.BUFFER.CLEAR
	## --- SET DEFAULT TEXT SCREEN COLOR
	PRINT RIGHT$(CLR.FGTEXT.NORMAL$,LEN(CLR.FGTEXT.NORMAL$)-2) ;
	RETURN


LOAD.ALL.SPRITES:
	BVLOAD "/SPRITES/SUSPECTS2.SPR",8,1,$3000
	#DEFINE SPRITE.TTL 7

	## 'If sprites are 32x32x4bpp (bits per pixel) then each pixel is 4 bits.
	## 'A byte is 8 bits, so each byte in memory holds 2 pixels. To get the size
	## 'you do 32*32/2=512
	OFFSET = 512

	FOR NDX = 1 TO SPRITE.TTL
		SPRMEM NDX,1,($3000 + (OFFSET * (NDX - 1))),0
		SPRITE NDX,0,0,0,2,2
		MOVSPR NDX,272,160
	NEXT
	RETURN

SHOW.SPRITE:
	GOSUB TURN.OFF.ALL.SPRITES
	## 'LOCATE 2,2 : PRINT CURRENT.SPRITE.NUM ;
	SPRITE CURRENT.SPRITE.NUM,3
	RETURN

TURN.OFF.ALL.SPRITES:
	FOR NDX = 1 TO SPRITE.TTL : SPRITE NDX,0 : NEXT
	RETURN

SHOW.KB.JOY.PROMPT:
	POKE 903,60	 : REM --- CHANGES THE ROW SIZE SO THE LAST CHAR DOES NOT SCROLL THE SCREEN
	LOCATE 30,1  : COLOR VAL(CLR.FGTEXT.ALERT$) : PRINT KboardJoyPrompt$;
	POKE 903,30  : REM --- PUT IT BACK TO THE ORIGINAL
	RETURN


