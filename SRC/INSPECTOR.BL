#CONTROLCODES 1
#SYMFILE "@:INSPECTOR.SYM"
#SAVEAS "@:INSPECTOR.PRG"

#DEFINE DEBUG 1

DIM MENU.TEXT$(10) : DIM MENU.TYPE(10) : DIM MENU.ATTR(4)  : REM -- USED BY MENUS-PROMPT.BL

DIM OPTIONS.SOUND : REM --- 1=ON / 2=OFF 
DIM OPTIONS.DIFICULTY : REM --- 1=EASY / 2=HARD
DIM OPTIONS.THEME  : REM --- 1=DARK / 2 = LIGHT
DIM OPTIONS.KB.JOY : REM --- 1=KB / 2=JOY --------------- !!!!!!!!!!! NOT USED ANYMORE !!!!!!!!!!!!!!!!


GOSUB SAVE.ENV : GOSUB NOTES.INIT
## GOSUB SYSTEM.FONT.SET.NOT.ISO.MODE : GOSUB SYSTEM.KEYBOARD.SET.PETSCIIGRAPHICS
POKE $030C,4 : SYS $FF62 : REM --- CHANGE TO THIN PET UPPER/GRAPHICS
GOSUB SOUND.INIT : GOSUB OPTIONS.INIT.VARS : SCREEN 3

IF OPTIONS.THEME = 2 THEN GOSUB SET.THEME.LIGHT
IF OPTIONS.THEME <> 2 THEN GOSUB SET.THEME.DARK : REM --- any non-2 value falls back to dark
X = INT(RND(-TI)) : REM --- SEED THE RND FUNCTION 

## AUTO NOTE TAKING - SAVE TXT FROM EACH SUSPECT TO ARRAY, SHOW IN EDIT PRG WHEN FKEY
## AUTO NOTE TAKING - SAVE TXT FROM EACH SUSPECT TO ARRAY, SHOW IN EDIT PRG WHEN FKEY
## AUTO NOTE TAKING - SAVE TXT FROM EACH SUSPECT TO ARRAY, SHOW IN EDIT PRG WHEN FKEY
## AUTO NOTE TAKING - SAVE TXT FROM EACH SUSPECT TO ARRAY, SHOW IN EDIT PRG WHEN FKEY


## --- TRUE GLOBALS VARS --------------------------
DIM SOLVED.CASE.PARTS(3) 
DIM OZ(5,9) : DIM SUSPECTS$(5) : DIM ROOMS$(6)
SUSPECTS$(1)="ALBERT":SUSPECTS$(2)="STACEY":SUSPECTS$(3)="BILL": SUSPECTS$(4)="ANDY":SUSPECTS$(5)="SUZY"
ROOMS$(1)="GARAGE":ROOMS$(2)="CLOSET":ROOMS$(3)="OFFICE": ROOMS$(4)="KITCHEN":ROOMS$(5)="LIBRARY":ROOMS$(6)="BASEMENT"
INTRO.MNU.DIMMED = 0 : SELECTED.SUSPECT.NDX = 1
## ------------------------------------------------

START:
 GOSUB NOTES.CLEAR
 COLOR VAL(CLR.FGTEXT.NORMAL$),VAL(CLR.BACKGROUND$) 
 GOSUB DRAW.INTRO.SCREEN
 CLS : GOSUB DRAW.DIAGRAM
 
 FOR X = 1 TO 5
  OZ(X,1) = INT(6 * RND(1)) + 1
 NEXT X

 FOR X = 2 TO 9
  FOR Y = 1 TO 5
   CONTINUE.FOR.450: 
   A = INT(6 * RND(1)) + 1
   IF A = OZ(Y,X - 1) THEN GOTO CONTINUE.FOR.450
   OZ(Y,X) = A
  NEXT Y
 NEXT X

 MurdererNameNdx = INT(5 * RND(1)) + 1
 MurdererTime    = INT(9 * RND(1)) + 1
 MurdererRoomNdx = OZ(MurdererNameNdx,MurdererTime)
 
 GOSUB LOAD.ALL.SPRITES
 
 IN.SUSPECT.PICKER.SCRN = 0
 
 IF MurdererNameNdx = 1 THEN GOTO LINE580
 
 FOR X = 1 TO MurdererNameNdx - 1
  CONTINUE.FOR.99:
  IF OZ(X,MurdererTime) = MurdererRoomNdx THEN OZ(X,MurdererTime) = (INT(5*RND(1)) + 1): GOTO CONTINUE.FOR.99
 NEXT X
 IF MurdererNameNdx = 5 THEN GOTO START.QUESTIONS

LINE580:
 FOR X = MurdererNameNdx + 1 TO 5
  CONTINUE.FOR.590:
  IF OZ(X,MurdererTime) = MurdererRoomNdx THEN OZ(X,MurdererTime) = (INT(5 * RND(1)) + 1): GOTO CONTINUE.FOR.590
 NEXT X
  
  
START.QUESTIONS:

 ## --- GET A SUSPECT TO QUESTION
 GOSUB CHANGE.MENU.SOUND
 ## IF SELECTED.SUSPECT.NDX = 0 THEN SELECTED.SUSPECT.NDX = 1
 CURRENT.SPRITE.NUM = SELECTED.SUSPECT.NDX
 ShowTheMugshotFlag = 1 : GOSUB SETUP.PROMPT.SCREEN
 
 #IFDEF DEBUG
 GOSUB DEBUG.SHOW
 #ENDIF
 
 LOCATE 16,3 : PRINT "QUESTION SOMEONE OR SOLVE THE CASE?";
 
 GOSUB MENU.SUSPECTS.INIT : GOSUB MENU.SUSPECTS.RUN
 
 IF MenuNdx = 6 THEN GOSUB NOTES.SHOW : GOTO START.QUESTIONS
 IF MenuNdx = 7 THEN GOTO SOLVE.CASE.NOW
 CURENT.SUSPECT$ = SUSPECTS$(MenuNdx) 
 SELECTED.SUSPECT.NDX = MenuNdx 
  
 
QUESTION.TIME.OR.PLACE:
 ## --- ASK TIME OR PLACE
 
 ShowTheMugshotFlag = 1 : GOSUB SETUP.PROMPT.SCREEN
 LOCATE 16,3 
 PRINT RIGHT$(CLR.FGTEXT.NORMAL$,LEN(CLR.FGTEXT.NORMAL$)-2) ; "WHAT DO YOU WANT TO ASK " CURENT.SUSPECT$ "?"; 
 GOSUB MENU.QUESTONS.TYPE.INIT : GOSUB MENU.QUESTONS.TYPE.RUN
 REM --- IF MenuNdx = 3 THEN GOTO START.QUESTIONS
 ON MenuNdx GOTO QUESTION.TIME, QUESTIONS.ROOM, START.QUESTIONS
  

## =========================================================================
## =========================================================================
## =========================================================================

QUESTION.TIME:

 GOSUB CHANGE.MENU.SOUND
 ShowTheMugshotFlag = 1 : GOSUB SETUP.PROMPT.SCREEN
 
 LOCATE 16,3 : PRINT SUSPECTS$(SELECTED.SUSPECT.NDX);
 LOCATE 17,3 : PRINT "WHERE WERE YOU AT {RVS ON}  1  {RVS OFF}'O CLOCK?"; 
 KboardJoyPrompt$ = "LEFT/RIGHT CHANGE TIME. FIRE TO CONTINUE" : GOSUB SHOW.KB.JOY.PROMPT
  
 TimeOfMurder = 1
 
 ## --- START OF LOOP
 KB.SCAN.START:
  GOSUB KB.JOY.KEYS.GET
  SLEEP(10)
  IF KB.STR$ = "R" OR KB.STR$ = "U" THEN TimeOfMurder = TimeOfMurder + 1 : GOSUB QUESTION.TIME.VALID.TIME : GOTO KB.SCAN.START
  IF KB.STR$ = "L" OR KB.STR$ = "D" THEN TimeOfMurder = TimeOfMurder - 1 : GOSUB QUESTION.TIME.VALID.TIME : GOTO KB.SCAN.START
  IF KB.STR$ = "F" THEN GOTO KB.SCAN.END :  REM '--- EXIT LOOP
  GOTO KB.SCAN.START : REM '--- DO THE LOOP AGAIN
 KB.SCAN.END:
   
 IF SELECTED.SUSPECT.NDX = MurdererNameNdx THEN GOTO LINE870 : REM '--- THIS IS THE MURDERER! SO HE MIGHT LIE TO YOU!
 GOTO LINE890
 
QUESTION.TIME.VALID.TIME: 
 ## - 'TODO, MAYBE A 'BINK' SOUND WHEN CHANGING THE TIMES?
 IF TimeOfMurder < 1 THEN TimeOfMurder = 1  
 IF TimeOfMurder > 9 THEN TimeOfMurder = 9
 LOCATE 17,22 : PRINT RIGHT$(CLR.FGTEXT.NORMAL$,LEN(CLR.FGTEXT.NORMAL$)-2) ; "{RVS ON}"  TimeOfMurder  "{RVS OFF}"; 
 RETURN

LINE870:
 IF RND(1) < .5 THEN GOTO LINE890
 LU = INT(5 * RND(1)) + 1 : GOTO QUESTION.TIME.ANSWER
 
LINE890:
 LU = OZ(SELECTED.SUSPECT.NDX,TimeOfMurder)
  
  
QUESTION.TIME.ANSWER:
 GOSUB CHANGE.MENU.SOUND
 ShowTheMugshotFlag = 1 : GOSUB SETUP.PROMPT.SCREEN
 ## ## GOSUB CLEAR.PROMPT.SCREEN : GOSUB SHOW.MUGSHOT : GOSUB KB.BUFFER.CLEAR
 
 ## ' REPLACE TIME IN TMP$ VAR (ALREADY PRINTED TO SCREEN) AND WRITE TO NOTEBOOK 
 ## STRS$(STR.TARGET) = TMP$ : STRS$(STR.FIND) = "1" : STRS$(STR.REPLACE) = STR$(TimeOfMurder)
 ## GOSUB STR.REPLACE.STR 
 
 LOCATE 17,3 :   PRINT CURENT.SUSPECT$ + ", AT" + STR$(TimeOfMurder) + "'CLOCK" 
 TMP$ = "Q: WHERE WAS " + CURENT.SUSPECT$ + " AT" + STR$(TimeOfMurder) + "'CLOCK"  : GOSUB NOTES.ADD
 
 TMP$ = "I WAS IN THE " + ROOMS$(LU)
 LOCATE 19,1 : PRINT TMP$ : GOSUB NOTES.ADD
 
 REM '--- THIS MIGHT NEED MORE WORK, IT WAS THE DIFFERANCE BETWEEN THE +4 VERSION AND THE C64 VERSION
 REM '--- THE C64 VERSION WAS CLAIMED TO BE EASIER, IT HAD THE .3 AND THE +4 HAD THE .2
 IF OPTIONS.DIFICULTY = 2 AND RND(1) > .2 THEN GOTO LINE940 : REM --- HARD
 IF OPTIONS.DIFICULTY = 1 AND RND(1) > .3 THEN GOTO LINE940 : REM --- EASY
  
 IF TimeOfMurder > MurdererTime THEN TMP$ = "BY THEN MR KIM WAS ALREADY DEAD!" : GOTO LINE940 
 TMP$ = "BY THEN MR KIM WAS STILL ALIVE!" 
 

LINE940:
 PRINT TMP$ : GOSUB NOTES.ADD
 
 REM --- WITHOUT THE USE OF BUGLINE VAR WE ARE GETTING A LF BETWEEN PRINT STATMENTS
 BUGLINE = 22 
 FOR X = 1 TO 5
  IF X = SELECTED.SUSPECT.NDX THEN GOTO CONTINUE.LINE970
  IF OZ(X,TimeOfMurder) = LU THEN GOSUB TIME.SHOW.INFO.ALSO
  ## ------ IF OZ(X,TimeOfMurder) = LU THEN PRINT ""SUSPECTS$(X) " WAS ALSO THERE"
  CONTINUE.LINE970:
 NEXT X

 REM '-- 980 
 REM '--- WITHOUT THE USE OF BUGLINE VAR WE ARE GETTING A LF BETWEEN PRINT STATMENTS
 FOR X = 1 TO 5
  IF SELECTED.SUSPECT.NDX = X THEN GOTO CONTINUE.LINE9709
  IF (OZ(X,TimeOfMurder) = LU-1) OR (OZ(X,TimeOfMurder) = LU + 1) THEN GOSUB TIME.SHOW.INFO.ALSO
  ## ----- IF (OZ(X,TimeOfMurder) = LU-1) OR (OZ(X,TimeOfMurder) = LU + 1) THEN PRINT ""SUSPECTS$(X)" WAS ALSO THERE" 
  CONTINUE.LINE9709:
 NEXT X

 GOSUB NOTES.ADD.LBREAK
 ## SLEEP 120
 GOSUB SHOW.CONTINUE.TXT.STR 
 GOSUB KB.JOY.KEYS.GET : REM --- JUST WAIT FOR ANY KEY

LINE1020:
 GOTO START.QUESTIONS 
 
TIME.SHOW.INFO.ALSO:
 REM '--- WITHOUT THE USE OF BUGLINE VAR WE ARE GETTING A LF BETWEEN PRINT STATMENTS
 LOCATE BUGLINE,1
 TMP$ = SUSPECTS$(X) + " WAS ALSO THERE"  :  PRINT TMP$ 
 GOSUB NOTES.ADD
 BUGLINE = BUGLINE + 1
 RETURN

  

## =========================================================================
 
QUESTIONS.ROOM:
 GOSUB CHANGE.MENU.SOUND
 ShowTheMugshotFlag = 1 : GOSUB SETUP.PROMPT.SCREEN
 
 TMP$ = CURENT.SUSPECT$ + ", WHEN WERE YOU IN THE..."
 LOCATE 17,1 : PRINT TMP$
 GOSUB MENU.QUESTONS.ROOMS.INIT : GOSUB MENU.QUESTONS.ROOMS.RUN
 SELECTED.ROOM.NDX = MenuNdx
 
 TMP$ = "Q: " + LEFT$(TMP$,LEN(TMP$)-3) + " " + ROOMS$(SELECTED.ROOM.NDX) 
 GOSUB NOTES.ADD
 
LINE1110:
 ShowTheMugshotFlag = 1 : GOSUB SETUP.PROMPT.SCREEN
 LOCATE 18,1 : PRINT CURENT.SUSPECT$ + " SAYS:"
 FOR X = 1 TO 5
  IF SUSPECTS$(X) = CURENT.SUSPECT$ THEN GOTO LINE1150
 NEXT X
  
LINE1150:
 SELECTED.SUSPECT.NDX = X 
 IF SELECTED.SUSPECT.NDX = MurdererNameNdx GOTO LINE1180 : REM -- 1160 
 GOTO LINE1260 : REM -- 1170 

LINE1180:
 IF MurdererRoomNdx = SELECTED.ROOM.NDX THEN GOTO LINE1200
 GOTO LINE1230

LINE1200:
 X = INT(RND(1) * 9 ) + 1
 GOSUB ROOM.SHOW.WHEN.TIME
 GOTO END.ROOM.QUESTION : REM GOTO LINE1020

LINE1230:
 IF RND(1)<.5 THEN GOTO LINE1260
 X = INT(RND(1) * 9) + 1
 IF RND(1)<.5 THEN GOSUB ROOM.SHOW.WHEN.TIME : GOTO END.ROOM.QUESTION : REM --GOTO LINE1020

LINE1260:
 X1=0  
 FOR X = 1 TO 9
  IF OZ(SELECTED.SUSPECT.NDX,X) = SELECTED.ROOM.NDX THEN GOSUB ROOM.SHOW.WHEN.TIME : X1=1
 NEXT X
 IF X1 = 0 THEN GOTO LINE1310
 GOTO END.ROOM.QUESTION : REM --GOTO LINE1020
 
LINE1310:
 TMP$ = "I WAS NEVER IN THE " + ROOMS$(SELECTED.ROOM.NDX) 
 PRINT TMP$ : GOSUB NOTES.ADD
 ## '## GOTO LINE1020
 
END.ROOM.QUESTION:
 ## 'SLEEP 120
 GOSUB NOTES.ADD.LBREAK
 GOSUB SHOW.CONTINUE.TXT.STR
 GOSUB KB.JOY.KEYS.GET : REM --- JUST WAIT FOR ANY KEY
 GOTO LINE1020

ROOM.SHOW.WHEN.TIME:
 PRINT "AT" + STR$(X) + "'CLOCK I WAS IN THE " + ROOMS$(SELECTED.ROOM.NDX) 
 TMP$ = "AT" + STR$(X) + "'CLOCK"  : GOSUB NOTES.ADD
 RETURN
 
 ## =========================================================================
 ## =========================================================================
 
UPDATE.SOLVED.GUESS:
 PRINT RIGHT$(CLR.FGTEXT.NORMAL$,LEN(CLR.FGTEXT.NORMAL$)-2);
 LOCATE 27,3 : PRINT "YOUR SUSPECT IS {RVS ON}"SUSPECTS$(GUESS.PICKED.SUSPECT)"{RVS OFF}  ";
 LOCATE 28,3 : PRINT "IN THE {RVS ON}"ROOMS$(GUESS.PICKED.ROOM)"{RVS OFF} AT {RVS ON}"RIGHT$(STR$(GUESS.PICKED.TIME),1)"'CLOCK{RVS OFF}   "; 
 RETURN
 
UPDATE.SOLVED.GUESS.CHANGE.SUSPECT:
 IF MENU.SCROLL.LR.SELECTED = 1 THEN GUESS.PICKED.SUSPECT = GUESS.PICKED.SUSPECT + 1 
 IF MENU.SCROLL.LR.SELECTED = 2 THEN GUESS.PICKED.SUSPECT = GUESS.PICKED.SUSPECT - 1
 IF GUESS.PICKED.SUSPECT > 5 THEN GUESS.PICKED.SUSPECT = 1 
 IF GUESS.PICKED.SUSPECT < 1 THEN GUESS.PICKED.SUSPECT = 5
 GOSUB SHOW.MUGSHOT
 RETURN
 
UPDATE.SOLVED.GUESS.CHANGE.ROOM:
 IF MENU.SCROLL.LR.SELECTED = 1 THEN GUESS.PICKED.ROOM = GUESS.PICKED.ROOM + 1 
 IF MENU.SCROLL.LR.SELECTED = 2 THEN GUESS.PICKED.ROOM = GUESS.PICKED.ROOM - 1
 IF GUESS.PICKED.ROOM > 6 THEN GUESS.PICKED.ROOM = 1 
 IF GUESS.PICKED.ROOM < 1 THEN GUESS.PICKED.ROOM = 6
 RETURN
 
UPDATE.SOLVED.GUESS.CHANGE.TIME:
 IF MENU.SCROLL.LR.SELECTED = 1 THEN GUESS.PICKED.TIME = GUESS.PICKED.TIME + 1 
 IF MENU.SCROLL.LR.SELECTED = 2 THEN GUESS.PICKED.TIME = GUESS.PICKED.TIME - 1
 IF GUESS.PICKED.TIME > 9 THEN GUESS.PICKED.TIME = 1 
 IF GUESS.PICKED.TIME < 1 THEN GUESS.PICKED.TIME = 9
 RETURN
 
SOLVE.CASE.NOW:

 GOSUB CHANGE.MENU.SOUND
 ShowTheMugshotFlag = 1 : GOSUB SETUP.PROMPT.SCREEN
 GUESS.PICKED.SUSPECT = 1 : GUESS.PICKED.ROOM = 1 : GUESS.PICKED.TIME = 1 
 PRINT RIGHT$(CLR.FGTEXT.NORMAL$,LEN(CLR.FGTEXT.NORMAL$)-2);
 LOCATE 17,3 : PRINT "INSPECTOR, ARE YOU SAYING"
 LOCATE 18,3 : PRINT "YOU SOLVED THIS CASE?"
   
 ## '--- START OF MENU LOOP
 GOSUB MENU.SOLVED.INIT
 GOSUB UPDATE.SOLVED.GUESS
 
 SOLVED.SCAN.START.LOOP:
  GOSUB MENU.SOLVED.RUN
  IF MenuNdx = 1 AND MENU.SCROLL.LR.SELECTED > 0 THEN GOSUB UPDATE.SOLVED.GUESS.CHANGE.SUSPECT
  IF MenuNdx = 2 AND MENU.SCROLL.LR.SELECTED > 0 THEN GOSUB UPDATE.SOLVED.GUESS.CHANGE.TIME
  IF MenuNdx = 3 AND MENU.SCROLL.LR.SELECTED > 0 THEN GOSUB UPDATE.SOLVED.GUESS.CHANGE.ROOM
  IF MenuNdx = 4 THEN GOTO CHECK.FOR.SOLVED.CASE
  IF MenuNdx = 5 THEN GOTO SHOW.SOLVED.CASE.FAILURE
  IF MenuNdx = 6 THEN GOTO START.QUESTIONS : REM --- EXIT MENU, BACK TO START
  GOSUB UPDATE.SOLVED.GUESS
 GOTO SOLVED.SCAN.START.LOOP : REM '--- END LOOP
  
 
CHECK.FOR.SOLVED.CASE:

 SLEEP(20) : GOSUB KB.BUFFER.CLEAR

 GOSUB CHANGE.MENU.SOUND
 ShowTheMugshotFlag = 0 : GOSUB SETUP.PROMPT.SCREEN
 
 LOCATE 17,3
 CASE.SOLVED = 0 : REM '--- IF THIS = 3 THEN CASE IS SOLVED
 
 IF GUESS.PICKED.SUSPECT  = MurdererNameNdx THEN PRINT "INDEED! "SUSPECTS$(GUESS.PICKED.SUSPECT)" IS THE MURDERER!" : SOLVED.CASE.PARTS(1) = 1
 IF GUESS.PICKED.SUSPECT <> MurdererNameNdx THEN PRINT "NOPE,"SUSPECTS$(GUESS.PICKED.SUSPECT)" IS NOT THE MURDERER!"
 
 LOCATE 19,3
 
 IF GUESS.PICKED.TIME = MurdererTime  THEN PRINT "FANTASTIC! THE MURDER TIME IS RIGHT!" : SOLVED.CASE.PARTS(2) = 1
 IF GUESS.PICKED.TIME <> MurdererTime THEN PRINT "NO, YOU FAILED TO GET THE TIME RIGHT."
 
 LOCATE 21,3
 
 IF GUESS.PICKED.ROOM = MurdererRoomNdx THEN PRINT "CORRECT, THE " ROOMS$(MurdererRoomNdx) " IS THE LOCATION!": SOLVED.CASE.PARTS(3) = 1
 IF GUESS.PICKED.ROOM <> MurdererRoomNdx THEN PRINT "THE ROOM IS INCORECT."
 REM --  ARE YOU REALLY AN INSPECTOR?
 SLEEP 180
 
 COLOR VAL(CLR.FGTEXT.ALERT$) : LOCATE 29,4 
 PRINT "INCOMING TEXT FROM THE BIG BOSS";
 GOSUB KB.BUFFER.CLEAR : GOSUB KB.JOY.KEYS.GET : GOSUB CHANGE.MENU.SOUND
 
 IF (SOLVED.CASE.PARTS(3) = 1 AND SOLVED.CASE.PARTS(2) = 1) AND SOLVED.CASE.PARTS(1) = 1 THEN GOTO SHOW.SOLVED.CASE.SUCCESS
 GOTO SHOW.SOLVED.CASE.FAILURE
 
 
SHOW.SOLVED.CASE.SUCCESS:
 ## '--- MAKE THIS RANDOM, YOU COULD READ IN DIFFERENT TXT FILES
 ## '--- WHAT A GUY!!!  TODO --- ADD SUCCESS SOUND - IF IS SOUND ON?
 GOSUB SHOW.SOLVED.CASE.HEADER
 PRINT "{DOWN}{DOWN}WHAT A GUY! SUCCESS!{DOWN}{DOWN}"
 PRINT "THE MURDERER " SUSPECTS$(MurdererNameNdx)" HAS JUST BEEN"
 ##   ' 0123456789012345678901234567890123456789
 PRINT "ARRESTED. YOU BUILT A SOLID CASE WITH"
 PRINT "ENOUGH EVIDENCE FOR AN ASSURED"
 PRINT "CONVICTION. A LETTER OF COMENDATION"
 PRINT "WILL BE ADDED TO YOUR PERSONAL FILE."
 PRINT "{DOWN}{DOWN}{DOWN}AGAIN... WHAT A GUY!
 GOSUB SHOW.CONTINUE.TXT.STR
 SLEEP(20) : GOSUB KB.BUFFER.CLEAR
 GOSUB KB.JOY.KEYS.GET
 GOTO START

SHOW.SOLVED.CASE.FAILURE:
 ## '--- WHAT REALLY HAPPENED!!!    TODO --- ADD FAILURE SOUND - IF IS SOUND ON?
 GOSUB SHOW.SOLVED.CASE.HEADER
 ## --- random put-downs + demotion jobs. To add one: append a line and bump the
 ## --- .TTL count; keep each under ~38 chars (one line); max 11 (auto-dim 0-10).
 DISP.TTL = 5
 DISP$(0) = "I'M DISAPPOINTED IN YOU!"
 DISP$(1) = "I EXPECTED MORE FROM YOU..."
 DISP$(2) = "YOU'VE LET ME DOWN, AGAIN..."
 DISP$(3) = "I THOUGHT YOU COULD DO BETTER."
 DISP$(4) = "I HAD HOPED FOR MORE FROM YOU?"

 JOB.TTL = 5
 JOB$(0) = "DIRECTING TRAFIC"
 JOB$(1) = "WRITING PARKING TICKETS"
 JOB$(2) = "GUARDING THE IMPOUND LOT"
 JOB$(3) = "MANNING THE LOST & FOUND"
 JOB$(4) = "PATROLLING THE DOG POUND"
 ##  '  0123456789012345678901234567890123456789
 PRINT "{DOWN}{DOWN}"
 PRINT DISP$(INT(DISP.TTL * RND(1)))
 PRINT "YOU REALLY ARE CLUE-LESS!"
 PRINT "{DOWN}{DOWN}HERE'S WHAT HAPPENED:"
 PRINT "{DOWN}AT AROUND "MurdererTime"'CLOCK, " SUSPECTS$(MurdererNameNdx)" MURDERED"
 PRINT "MR KIM IN THE "ROOMS$(MurdererRoomNdx)"{DOWN}"
 PRINT "MAYBE YOUR NEXT ASSIGNMENT WILL BE"
 PRINT JOB$(INT(JOB.TTL * RND(1)))"?"
 PRINT "JUST CLUE-LESS..."
 GOSUB SHOW.CONTINUE.TXT.STR
 SLEEP(20) : GOSUB KB.BUFFER.CLEAR
 GOSUB KB.JOY.KEYS.GET
 GOTO START
 ## CLOSE.APP
 
SHOW.SOLVED.CASE.HEADER: 
 GOSUB TURN.OFF.ALL.SPRITES
 PRINT RIGHT$(CLR.FGTEXT.NORMAL$,LEN(CLR.FGTEXT.NORMAL$)-2);
 CLS : PRINT "{DOWN}{DOWN}{DOWN}"
 ##  '  0123456789012345678901234567890123456789
 PRINT "FROM: THE CHIEF INSPECTOR"
 PRINT "{DOWN}TO: INSPECTOR CLUE-LESS"
 PRINT RPT$(ASC("-"),38)
 RETURN

SHOW.CONTINUE.TXT.STR:
 KboardJoyPrompt$ = "          PRESS FIRE TO CONTINUE" : GOSUB SHOW.KB.JOY.PROMPT
 RETURN

CHANGE.MENU.SOUND:
 IF OPTIONS.SOUND <> 1 THEN RETURN
 GOSUB SOUND.CLICK : RETURN


#IFDEF DEBUG 
DEBUG.SHOW:
 ## '---  DEBUG 
 LOCATE 1,1 
 ## ' MurdererNameNdx = MU
 ## ' MurdererRoomNdx = RA
 ## ' MurdererTime = TZ
 PRINT  "MEM:" ; FRE(0)
 ## PRINT  "MURDER:" SUSPECTS$(MurdererNameNdx) " TIME:"MurdererTime" ROOM:"ROOMS$(MurdererRoomNdx);
 RETURN
#ENDIF
 
 
